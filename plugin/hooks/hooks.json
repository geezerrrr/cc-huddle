{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/dist/session-start.mjs"]
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/dist/permission-mode.mjs"]
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__plugin_cc-huddle_huddle__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/dist/permission-mode.mjs"]
          }
        ]
      }
    ]
  },
  "modules": ["./register.tsx"]
}
